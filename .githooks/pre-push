#!/bin/bash

# ------------------- Compile Maven Project -------------------- #

# Store the current working directory
CWD=$(pwd)

# Log the operation
echo "Running pre-push hook from directory: $CWD"

# Move to the project directory which you want to compile
# need to write code

# Run Maven test-compile to ensure code compiles before pushing
echo '-------------------- MAVEN TEST-COMPILE STARTED -----------------------------'
printf "\n\n"
echo "Compiling project with Maven..."
mvn test-compile

# Check the exit status of the Maven command
if [ $? -ne 0 ]; then
    cd $CWD
    echo 'Git Push [ABORTED] >-----------> because of existing issues, Please check logs!'
    exit 1
else
    printf "\n\n"
    echo 'Compilation Status: No issues found >--------------------------> [SUCCESSFUL]'
    echo 'Git Push >-----------------------------------------------------> [SUCCESSFUL]'
    printf '\n\n'
    exit 0
fi
cd $CWD
